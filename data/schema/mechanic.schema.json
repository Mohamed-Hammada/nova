{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game mechanic",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "description": { "type": "string", "minLength": 1 }
  }
}
