{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Journey (the level map for one age group)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name_key",
    "age_range",
    "stages",
    "levels"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^journey\\.[a-z0-9_-]+$"
    },
    "name_key": {
      "type": "string",
      "minLength": 1
    },
    "age_range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 2,
        "maximum": 8
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "oneOf": [
          {
            "required": [
              "game"
            ],
            "not": {
              "required": [
                "games_by_language"
              ]
            }
          },
          {
            "required": [
              "games_by_language"
            ],
            "not": {
              "required": [
                "game"
              ]
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "game": {
            "type": "string"
          },
          "games_by_language": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z]{2,3}$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "skin": {
            "enum": [
              "apples",
              "carrots",
              "fish",
              "stars",
              "balls",
              "flowers",
              "shells",
              "hearts"
            ]
          },
          "role": {
            "enum": [
              "required",
              "practice",
              "challenge",
              "optional",
              "review"
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "minutes": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 30
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "place",
          "age_range",
          "levels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^stage\\.[a-z0-9_-]+\\.[a-z0-9_-]+$"
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          },
          "place": {
            "enum": [
              "numbers",
              "language",
              "sounds",
              "feelings",
              "memory",
              "discovery",
              "movement"
            ]
          },
          "age_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 2,
              "maximum": 8
            }
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "copy_status": {
            "enum": [
              "draft",
              "reviewed"
            ]
          }
        }
      }
    }
  }
}
